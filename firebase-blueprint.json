{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered customer, contractor, vehicle owner, or admin profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 20 },
        "role": { "type": "string", "enum": ["customer", "owner", "admin"] },
        "companyName": { "type": "string", "maxLength": 150 },
        "address": { "type": "string", "maxLength": 300 },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "phone", "role"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Construction equipment listing available for hire",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "type": { "type": "string" },
        "regNumber": { "type": "string", "maxLength": 30 },
        "capacityTons": { "type": "number" },
        "capacityDisplay": { "type": "string", "maxLength": 50 },
        "pricePerDay": { "type": "number" },
        "location": { "type": "string", "maxLength": 100 },
        "distanceKm": { "type": "number" },
        "driverAvailable": { "type": "boolean" },
        "driverFeePerDay": { "type": "number" },
        "availabilityStatus": { "type": "string", "enum": ["Available", "Booked", "Maintenance"] },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "ownerId": { "type": "string" },
        "ownerName": { "type": "string", "maxLength": 100 },
        "ownerPhone": { "type": "string", "maxLength": 20 },
        "ownerRating": { "type": "number" },
        "image": { "type": "string" },
        "description": { "type": "string", "maxLength": 1000 },
        "isApproved": { "type": "boolean" },
        "documentsVerified": { "type": "boolean" }
      },
      "required": ["id", "name", "type", "regNumber", "pricePerDay", "ownerId"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Machine hire contract between customer and fleet owner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 20 },
        "vehicleId": { "type": "string" },
        "vehicleName": { "type": "string", "maxLength": 150 },
        "vehicleType": { "type": "string" },
        "vehicleImage": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerName": { "type": "string", "maxLength": 100 },
        "ownerPhone": { "type": "string", "maxLength": 20 },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "durationDays": { "type": "number" },
        "pickupLocation": { "type": "string", "maxLength": 200 },
        "destination": { "type": "string", "maxLength": 200 },
        "materialType": { "type": "string" },
        "quantity": { "type": "string", "maxLength": 100 },
        "driverRequired": { "type": "boolean" },
        "vehiclePrice": { "type": "number" },
        "driverFee": { "type": "number" },
        "platformFee": { "type": "number" },
        "gstAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Driver Assigned", "In Progress", "Completed", "Cancelled"] },
        "paymentStatus": { "type": "string", "enum": ["Paid", "Pending", "Refunded"] },
        "paymentMethod": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerId", "vehicleId", "totalAmount", "status"]
    },
    "Project": {
      "title": "Project",
      "description": "Site infrastructure project tracking multiple equipment deployments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "location": { "type": "string", "maxLength": 200 },
        "durationDays": { "type": "number" },
        "startDate": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Completed", "Planning"] },
        "todayTrips": { "type": "number" },
        "materialsMovedTons": { "type": "number" },
        "estimatedBudget": { "type": "number" },
        "spentAmount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "customerId", "name", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile records indexed by user ID"
    },
    "/vehicles/{vehicleId}": {
      "schema": "Vehicle",
      "description": "Machinery listings available in the marketplace"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Equipment hire bookings and orders"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Contractor construction projects"
    }
  }
}
